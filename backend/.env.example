# --- Database -------------------------------------------------------------
# SQLite (development default)
DATABASE_URL=sqlite:///./placementlens.db
# PostgreSQL (production) - requires `pip install "psycopg[binary]"`
# DATABASE_URL=postgresql+psycopg://placementlens:password@localhost:5432/placementlens

# --- API ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dataset --------------------------------------------------------------
# Path to the dataset loaded on first start. The bundled file is a clearly
# labelled DEMONSTRATION dataset; point this at your own export to analyse
# real placement data, and set DATASET_IS_DEMO=false once you do.
DATASET_PATH=app/data/demo_dataset.json
DATASET_IS_DEMO=true

# --- Semantic analysis ----------------------------------------------------
# When false the pipeline trains Word2Vec on the local corpus (no downloads).
ENABLE_SENTENCE_TRANSFORMERS=false
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
